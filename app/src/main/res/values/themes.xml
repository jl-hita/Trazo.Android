<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="trazo_background">#0D1119</color>

    <!-- Dark window: no white flash at launch, and the system bars match the app. -->
    <style name="Theme.Trazo" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/trazo_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
