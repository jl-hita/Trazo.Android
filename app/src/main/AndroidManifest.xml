<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="android.permission.INTERNET"/>
 <!-- Google Play Billing: inactive until the backend requires a subscription. -->
 <uses-permission android:name="com.android.vending.BILLING"/>
 <!-- Push notifications (Android 13+ asks the user at runtime). -->
 <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
 <!-- No copy of the app data leaves the device: neither cloud backup nor device-to-device transfer (see data_extraction_rules.xml). -->
 <application android:name=".TrazoApp" android:allowBackup="false" android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules" android:localeConfig="@xml/locales_config" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:label="@string/app_name" android:supportsRtl="true" android:theme="@style/Theme.Trazo">
  <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
   <!--
    Verified App Links (https), not a custom scheme: any app can register "trazo://" and receive the password-reset
    token, but only this app can be verified for the site's domain (it publishes /.well-known/assetlinks.json).
    Until that file is published the links simply open the web pages, which do the same job.
   -->
   <intent-filter android:autoVerify="true">
    <action android:name="android.intent.action.VIEW"/>
    <category android:name="android.intent.category.DEFAULT"/>
    <category android:name="android.intent.category.BROWSABLE"/>
    <data android:scheme="https" android:host="${appLinkHost}"/>
    <data android:pathPrefix="/account/verify-email"/>
    <data android:pathPrefix="/account/reset-password"/>
    <data android:pathPrefix="/invite"/>
   </intent-filter>
  </activity>
  <service android:name=".push.TrazoMessagingService" android:exported="false">
   <intent-filter><action android:name="com.google.firebase.MESSAGING_EVENT"/></intent-filter>
  </service>
 </application>
</manifest>
